{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error",
    "import/no-cycle": "error"
  },
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/application/**",
                  "@/infra/**",
                  "@/presentation/**",
                  "**/application/**",
                  "**/infra/**",
                  "**/presentation/**"
                ],
                "message": "domain não pode importar outras camadas."
              },
              {
                "group": ["@nestjs/*"],
                "message": "domain não pode depender do framework."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/application/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/infra/**",
                  "@/presentation/**",
                  "**/infra/**",
                  "**/presentation/**"
                ],
                "message": "application só pode importar domain."
              },
              {
                "group": ["@nestjs/*"],
                "message": "application não pode depender do framework."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/presentation/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/infra/**", "**/infra/**"],
                "message": "presentation não pode importar infra."
              }
            ]
          }
        ]
      }
    }
  ]
}